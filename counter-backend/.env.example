# Copia este archivo como app/.env y complétalo.
# NUNCA se versiona: contiene credenciales.

# --- Base de datos ---
# La contraseña va porcentaje-codificada: ! → %21, @ → %40, : → %3A
# En local:      localhost:3307/portafolioback
# En producción: localhost:3306/<base_del_hosting>
DATABASE_URL=mysql://usuario:password@localhost:3306/nombre_base

# --- Orígenes autorizados (separados por coma, sin espacios) ---
# Debe incluir el dominio real del sitio publicado.
CORS_ORIGINS=https://portafolio.surcode.cl,http://localhost:4321

# --- Correo del formulario de contacto ---
SMTP_HOST=mail.surcode.cl
SMTP_PORT=465
SMTP_USER=contacto@surcode.cl
SMTP_PASSWORD=
CONTACT_TO=
