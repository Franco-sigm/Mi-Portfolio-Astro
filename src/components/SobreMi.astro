---
import { Image } from 'astro:assets';
import { PROFILE } from '../consts';
import moto from '../assets/moto.jpg';
---

<section
  id="inicio"
  class="container mx-auto flex min-h-screen items-center px-6 pt-24 pb-12 md:px-8"
>
  <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 md:gap-16">
    <div class="order-2 text-center md:order-1 md:text-left">
      <p class="mb-3 font-medium text-cyan-400">👋 Hola, soy</p>
      <h1 class="mb-2 text-4xl font-bold text-white md:text-5xl">
        {PROFILE.name}
      </h1>
      <h2 class="section-franco mb-6 !text-2xl text-yellow md:!text-3xl">
        {PROFILE.role}
      </h2>
      <p class="mx-auto mb-8 max-w-md text-lg leading-relaxed text-gray-300 md:mx-0">
        {PROFILE.tagline}
      </p>

      <!-- CTAs -->
      <div class="mb-8 flex flex-wrap justify-center gap-4 md:justify-start">
        <a href="#proyectos" class="btn-primary">Ver mis proyectos</a>
        <a href={PROFILE.cvPath} download class="button-yellow">Descargar CV</a>
        <a href="#contacto" class="btn-outline">Contacto</a>
      </div>

      <!-- Redes -->
      <div class="flex justify-center gap-6 md:justify-start">
        <a
          href={PROFILE.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="text-gray-400 transition-colors hover:text-cyan-400"
        >
          <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </a>
        <a
          href={PROFILE.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="text-gray-400 transition-colors hover:text-cyan-400"
        >
          <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.168 6.839 9.492.5.092.682-.217.682-.482 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.031-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.03 1.595 1.03 2.688 0 3.848-2.338 4.695-4.566 4.942.359.308.678.92.678 1.852 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.001 10.001 0 0022 12c0-5.523-4.477-10-10-10z" clip-rule="evenodd"/></svg>
        </a>
        <a
          href={`mailto:${PROFILE.email}`}
          aria-label="Email"
          class="text-gray-400 transition-colors hover:text-cyan-400"
        >
          <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z"/><path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"/></svg>
        </a>
      </div>
    </div>

    <div class="order-1 flex items-center justify-center md:order-2">
      <div class="h-72 w-72 rounded-full bg-gradient-to-br from-cyan-500 to-yellow-400 p-1.5 md:h-80 md:w-80">
        <Image
          src={moto}
          alt={`Foto de perfil de ${PROFILE.name}`}
          class="h-full w-full rounded-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
