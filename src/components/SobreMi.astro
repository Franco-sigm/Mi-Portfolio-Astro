---
import { Image } from 'astro:assets';
import { CONTACT, PROFILE, STACK } from '../consts';
import moto from '../assets/moto.jpg';
---

<section
  id="inicio"
  class="container mx-auto flex min-h-screen items-center px-6 pt-24 pb-12 md:px-8"
>
  {/* items-start en escritorio: las dos columnas arrancan arriba, así la
      foto no queda flotando en el centro y todo lo que sobra abajo queda
      para el stack. En móvil se apilan, ahí centrar sí tiene sentido. */}
  <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 md:items-start md:gap-16">
    <div class="order-2 text-center md:order-1 md:text-left">
      <p class="mb-3 font-medium text-cyan-400">👋 Hola, soy</p>
      <h1
        class="font-display mb-3 text-5xl font-bold leading-[1.04] tracking-tight text-white sm:text-6xl md:text-7xl"
      >
        {PROFILE.name}
      </h1>
      {/* El cargo baja a línea de apoyo: si compite en tamaño con el
          nombre, el hero se lee plano y no hay jerarquía. */}
      <h2 class="mb-6 max-w-md text-base font-medium leading-snug text-gray-400 md:mx-0">
        {PROFILE.role}
      </h2>
      <p class="mx-auto mb-8 max-w-md whitespace-pre-line text-lg leading-relaxed text-gray-300 md:mx-0">
        {PROFILE.tagline}
      </p>

      <!-- CTAs -->
      <div class="mb-8 flex flex-wrap justify-center gap-4 md:justify-start">
        <a href="#proyectos" class="btn-primary">Ver mis proyectos</a>
        <a href={CONTACT.cvPath} download class="button-acento">Descargar CV</a>
        <a href="#contacto" class="btn-outline">Contacto</a>
      </div>

      <!-- Redes -->
      <div class="flex justify-center gap-6 md:justify-start">
        <a
          href={CONTACT.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="text-gray-400 transition-colors hover:text-cyan-400"
        >
          <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </a>
        <a
          href={CONTACT.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="text-gray-400 transition-colors hover:text-cyan-400"
        >
          <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.168 6.839 9.492.5.092.682-.217.682-.482 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.031-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.03 1.595 1.03 2.688 0 3.848-2.338 4.695-4.566 4.942.359.308.678.92.678 1.852 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.001 10.001 0 0022 12c0-5.523-4.477-10-10-10z" clip-rule="evenodd"/></svg>
        </a>
        <a
          href={`mailto:${CONTACT.email}`}
          aria-label="Email"
          class="text-gray-400 transition-colors hover:text-cyan-400"
        >
          <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z"/><path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"/></svg>
        </a>
      </div>
    </div>

    <div class="order-1 flex flex-col items-center gap-7 md:order-2">
      <div class="h-60 w-60 shrink-0 rounded-full bg-gradient-to-br from-cyan-400 to-blue-600 p-1.5 sm:h-64 sm:w-64 md:h-72 md:w-72">
        <Image
          src={moto}
          alt={`Foto de perfil de ${PROFILE.name}`}
          class="h-full w-full rounded-full object-cover"
        />
      </div>

      {/* El stack acompaña a la foto: equilibra la altura de la columna
          de texto y pone las herramientas junto a la persona. */}
      <div class="w-full">
        <h3 class="mb-5 text-center text-lg font-bold text-white">Mi stack</h3>

        <div class="space-y-6">
          {
            STACK.map((grupo) => (
              <div>
                <p class="mb-3 text-center text-[0.7rem] font-semibold uppercase tracking-wider text-cyan-400">
                  {grupo.category}
                </p>
                {/* Celdas de ancho fijo: todas ocupan lo mismo, así los
                    logos quedan alineados en columnas aunque los nombres
                    tengan largos distintos. */}
                <div class="flex flex-wrap justify-center gap-x-3 gap-y-4">
                  {grupo.items.map((item) => (
                    <div class="flex w-[5.25rem] flex-col items-center gap-2">
                      <img
                        src={item.icon}
                        alt=""
                        aria-hidden="true"
                        width="88"
                        height="88"
                        loading="lazy"
                        class:list={[
                          'h-11 w-11 shrink-0 object-contain transition-transform duration-200 hover:scale-110',
                          item.invert && 'icon-invert',
                        ]}
                      />
                      <span class="text-center text-[0.72rem] leading-tight text-gray-400">
                        {item.name}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
