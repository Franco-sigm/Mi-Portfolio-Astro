---
import { PROJECTS } from '../consts';
import ProyectoFila from './ProyectoFila.astro';

// Cuántos proyectos se ven sin desplegar. Los de consts.ts van ordenados
// de mayor a menor, así que los primeros son los que conviene mostrar.
const VISIBLES = 5;
const destacados = PROJECTS.slice(0, VISIBLES);
const resto = PROJECTS.slice(VISIBLES);
---

<section id="proyectos" class="mx-auto max-w-5xl px-6 py-20">
  <h2 class="section-subtitle text-center">Mis Proyectos</h2>
  <p class="mx-auto mb-16 max-w-2xl text-center text-gray-400">
    El problema que resolvía cada uno, cómo lo construí y en qué está hoy.
  </p>

  <div class="space-y-20">
    {destacados.map((p, i) => <ProyectoFila proyecto={p} invertida={i % 2 === 1} />)}

    {
      resto.length > 0 && (
        /* Sin JavaScript esto queda abierto y el botón oculto: el script
           es el que cierra la lista al cargar. Así nadie se queda sin ver
           proyectos si el script no llega a ejecutarse. */
        <div id="proyectos-resto" class="space-y-20">
          {resto.map((p, i) => (
            <ProyectoFila proyecto={p} invertida={(VISIBLES + i) % 2 === 1} />
          ))}
        </div>
      )
    }
  </div>

  {
    resto.length > 0 && (
      <div class="mt-16 text-center">
        <button
          id="proyectos-toggle"
          type="button"
          class="btn-outline inline-flex items-center gap-2"
          aria-controls="proyectos-resto"
          aria-expanded="true"
          hidden
        >
          <span data-texto>Ver menos</span>
          <svg
            class="flecha h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
      </div>
    )
  }
</section>

<style>
  /* La flecha apunta hacia arriba cuando la lista está desplegada. */
  #proyectos-toggle[aria-expanded='true'] .flecha {
    transform: rotate(180deg);
  }

  .flecha {
    transition: transform 0.2s ease;
  }

  /* El botón nace con [hidden] y el script se lo quita. Tailwind no
     define display para .btn-outline, pero lo dejamos explícito por si
     alguna clase de utilidad se lo pusiera después. */
  #proyectos-toggle[hidden],
  #proyectos-resto[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .flecha {
      transition: none;
    }
  }
</style>

<script>
  const boton = document.getElementById('proyectos-toggle');
  const resto = document.getElementById('proyectos-resto');

  if (boton && resto) {
    const texto = boton.querySelector<HTMLElement>('[data-texto]');
    const cuantos = resto.children.length;

    const pintar = (abierto: boolean) => {
      resto.hidden = !abierto;
      boton.setAttribute('aria-expanded', String(abierto));
      if (texto) {
        texto.textContent = abierto
          ? 'Ver menos'
          : `Ver ${cuantos} proyecto${cuantos === 1 ? '' : 's'} más`;
      }
    };

    // Estado inicial: plegado. Se hace desde el script para que sin JS
    // la sección quede completa en vez de recortada.
    pintar(false);
    boton.hidden = false;

    boton.addEventListener('click', () => {
      const abriendo = boton.getAttribute('aria-expanded') !== 'true';
      pintar(abriendo);
      // Al plegar, el botón queda muy abajo respecto de lo que se ve:
      // lo traemos de vuelta a la vista para no dejar al usuario perdido.
      if (!abriendo) {
        boton.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
    });
  }
</script>
