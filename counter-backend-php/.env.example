# Copia este archivo como .env y complétalo. NUNCA se versiona.
# El .htaccess impide que se sirva por HTTP.

# La contraseña va porcentaje-codificada: ! → %21, @ → %40, : → %3A
DATABASE_URL=mysql://usuario:password@localhost:3306/nombre_base

# Orígenes autorizados, separados por coma y sin espacios
CORS_ORIGINS=https://portafolio.surcode.cl

# Correo del formulario de contacto
SMTP_USER=contacto@surcode.cl
CONTACT_TO=tu-correo@ejemplo.com
